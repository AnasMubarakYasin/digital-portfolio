{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "@lib/*": ["./lib/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@stores/*": ["./src/stores/*"],
      "@context/*": ["./src/context/*"],
      "@config/*": ["./src/config/*"]
      // "@services/*": ["src/services/*"],
      // "@assets/*": ["src/assets/*"]
    }
  }
}